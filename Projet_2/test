import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit


# ============================================================
# PARAMÈTRES
# ============================================================
ANGLE_MIN  = 180
ANGLE_MAX  = 360
# ============================================================

base_dir   = os.path.dirname(os.path.abspath(__file__))
excel_path = os.path.join(base_dir, "Projet_2_31_mars.xlsx")

df = pd.read_excel(excel_path, sheet_name="Essai2", header=1)


# =========================
# DONNÉES (angles inchangés)
# =========================
x = df.iloc[:, 1].values.astype(float)


def sinusoidal(x, A, phi, C):
    return A * np.cos(np.deg2rad(2 * x + phi)) + C


vec_col = ["#B4A8C9"]

fig, ax = plt.subplots(figsize=(13, 7))


# =========================
# COLONNE "vide"
# =========================
col = "vide"

y_raw = pd.to_numeric(df[col], errors='coerce').values

# suppression uniquement des NaN
valid = ~np.isnan(x) & ~np.isnan(y_raw)

x = x[valid]
y = y_raw[valid]


# =========================
# NORMALISATION
# =========================
y_shifted = y - np.min(y)
y_max = np.max(y_shifted)

if y_max != 0:
    y_norm = y_shifted / y_max
else:
    y_norm = y_shifted


ax.scatter(x, y_norm, color=vec_col[0], s=25, alpha=0.55, zorder=3)


try:
    p0     = [0.5, 0.0, 0.5]
    bounds = ([-1.5, -360, -0.5], [1.5, 360, 1.5])

    popt, pcov = curve_fit(
        sinusoidal,
        x,
        y_norm,
        p0=p0,
        bounds=bounds,
        maxfev=20000
    )

    A, phi, C = popt


    # ============================================================
    # θ_max (CORRIGÉ : extraction directe du maximum du fit)
    # ============================================================
    x_grid = np.linspace(0, 360, 20000)
    y_grid = sinusoidal(x_grid, *popt)

    x_max = x_grid[np.argmax(y_grid)]


    # ============================================================
    # incertitude (approx)
    # ============================================================
    dphi = np.sqrt(pcov[1, 1]) if pcov is not None else np.nan

    sigma_theta = np.nan
    if not np.isnan(dphi):
        sigma_theta = dphi / 2  # approximation cohérente avec cos(2x)


    # ============================================================
    # courbe ajustée
    # ============================================================
    x_smooth = np.linspace(ANGLE_MIN, ANGLE_MAX, 2000)
    y_smooth = sinusoidal(x_smooth, *popt)

    ax.plot(
        x_smooth, y_smooth,
        color=vec_col[0],
        linewidth=2,
        label=f"vide | θ_max = {x_max:.2f} ± {sigma_theta:.2f}°"
    )

    ax.axvline(x_max, color=vec_col[0], linestyle='--', linewidth=0.7, alpha=0.4)

except RuntimeError:
    print("Curve fit échoué pour : vide")


# =========================
# GRAPH SETTINGS
# =========================
ax.axvline(0, color='black', linewidth=1.2, linestyle='-', alpha=0.5, label='θ − θ₀ = 0°')
ax.set_xlabel("Angle θ (degrés)", fontsize=13)
ax.set_ylabel("Courant normalisé (u.a.)", fontsize=13)
ax.legend(fontsize=8.5, loc='upper right', framealpha=0.92)
ax.grid(True, alpha=0.3)
ax.set_xlim(ANGLE_MIN, ANGLE_MAX)
ax.set_ylim(-0.05, 1.15)

plt.tight_layout()
plt.show()

out_path = os.path.join(base_dir, "plot_fructose.png")
